:root {
  --bg: #06070b;
  --bg-2: #0b0d14;
  --glass: rgba(18, 21, 32, 0.62);
  --glass-2: rgba(255, 255, 255, 0.035);
  --line: rgba(255, 255, 255, 0.08);
  --line-2: rgba(255, 255, 255, 0.14);
  --t1: #f2f4fa;
  --t2: #a7adc2;
  --t3: #6b7189;
  --mint: hsl(158, 100%, 68%);
  --violet: hsl(248, 100%, 74%);
  --amber: hsl(38, 100%, 64%);
  --danger: hsl(355, 90%, 66%);
  --grad: linear-gradient(120deg, var(--mint), var(--violet));
  --r: 18px;
  --font: "Inter", system-ui, sans-serif;
  --display: "Space Grotesk", var(--font);
  --mono: "JetBrains Mono", ui-monospace, monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--t1);
  font-family: var(--font);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a { color: var(--mint); text-decoration: none; border-bottom: 1px solid rgba(93, 255, 196, 0.3); }
a:hover { border-color: var(--mint); }
.wrap { width: min(1180px, 92vw); margin: 0 auto; }

/* ---------- background ---------- */
.bg-orbs { position: fixed; inset: 0; z-index: -2; overflow: hidden; }
.bg-orbs span {
  position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.35;
  animation: drift 22s ease-in-out infinite alternate;
}
.bg-orbs span:nth-child(1) { width: 520px; height: 520px; background: hsl(158, 90%, 40%); top: -160px; left: -120px; }
.bg-orbs span:nth-child(2) { width: 620px; height: 620px; background: hsl(248, 80%, 50%); top: 30%; right: -220px; animation-delay: -7s; }
.bg-orbs span:nth-child(3) { width: 420px; height: 420px; background: hsl(200, 90%, 40%); bottom: -180px; left: 30%; animation-delay: -14s; opacity: 0.22; }
@keyframes drift { to { transform: translate(60px, 40px) scale(1.12); } }
.bg-grid {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
  background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse at 50% 0%, #000 0%, transparent 70%);
  opacity: 0.5;
}

.glass {
  background: var(--glass);
  border: 1px solid var(--line);
  border-radius: var(--r);
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  box-shadow: 0 20px 60px -30px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

/* ---------- top bar ---------- */
.topbar { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(14px); background: rgba(6, 7, 11, 0.6); border-bottom: 1px solid var(--line); }
.topbar-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
.brand { display: flex; align-items: center; gap: 10px; border: 0; color: var(--t1); font-family: var(--display); font-size: 18px; letter-spacing: 0.04em; }
.brand b { font-weight: 500; color: var(--t2); margin-left: 6px; }
.brand-mark { width: 28px; height: 28px; animation: spin 18s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.pill { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--t2); padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--glass-2); font-family: var(--mono); }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 10px var(--amber); }
.pill.ok .dot { background: var(--mint); box-shadow: 0 0 10px var(--mint); animation: pulse 2s infinite; }
.pill.err .dot { background: var(--danger); box-shadow: 0 0 10px var(--danger); }
@keyframes pulse { 50% { opacity: 0.4; } }

/* ---------- hero ---------- */
.hero { padding: 64px 0 34px; text-align: center; }
.eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--mint); margin: 0 0 14px; }
h1 { font-family: var(--display); font-size: clamp(36px, 6vw, 68px); line-height: 1.02; letter-spacing: -0.03em; margin: 0 0 18px; font-weight: 700; }
.grad { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
.lede { max-width: 720px; margin: 0 auto; color: var(--t2); font-size: 17px; }
.lede b { color: var(--t1); font-weight: 600; }
.hero-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 38px; }
.stat { padding: 18px 20px; text-align: left; display: flex; flex-direction: column; gap: 4px; transition: transform 0.25s, border-color 0.25s; }
.stat:hover { transform: translateY(-3px); border-color: var(--line-2); }
.stat .k { font-size: 12px; color: var(--t3); text-transform: uppercase; letter-spacing: 0.08em; }
.stat .v { font-family: var(--display); font-size: 28px; font-weight: 600; }
.stat .u { font-size: 12px; color: var(--t2); font-family: var(--mono); }

/* ---------- layout ---------- */
.grid-main { display: grid; grid-template-columns: 1.05fr 1fr; gap: 20px; align-items: start; }
.card { padding: 26px; }
.card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
.card-head.sub { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); }
.card-head h2 { font-family: var(--display); font-size: 20px; margin: 0; font-weight: 600; }
.step { font-family: var(--mono); font-size: 11px; color: var(--bg); background: var(--grad); padding: 3px 8px; border-radius: 6px; font-weight: 500; }

/* ---------- fields ---------- */
.field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; border: 0; padding: 0; min-width: 0; }
.lbl { font-size: 13px; color: var(--t2); font-weight: 500; padding: 0; }
.lbl em { color: var(--t3); font-style: normal; font-weight: 400; }
.hint { font-size: 12px; color: var(--t3); }
input[type="text"], input[type="number"], select {
  width: 100%; background: rgba(0, 0, 0, 0.35); border: 1px solid var(--line); border-radius: 12px;
  color: var(--t1); padding: 12px 14px; font: 500 14px var(--font); outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
input#wallet-input { font-family: var(--mono); font-size: 13px; }
input:focus, select:focus { border-color: hsla(158, 100%, 68%, 0.6); box-shadow: 0 0 0 4px hsla(158, 100%, 68%, 0.1); }
input.invalid { border-color: var(--danger); }
.input-row { display: flex; gap: 10px; }
.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

/* ---------- buttons ---------- */
.btn { cursor: pointer; border: 0; border-radius: 12px; font: 600 14px var(--font); padding: 12px 18px; transition: transform 0.15s, box-shadow 0.25s, background 0.2s, opacity 0.2s; white-space: nowrap; }
.btn:active { transform: scale(0.97); }
.btn:disabled { opacity: 0.55; cursor: progress; }
.btn-primary { width: 100%; margin-top: 22px; padding: 16px; font-size: 15px; color: #04110c; background: var(--grad); box-shadow: 0 10px 30px -10px hsla(158, 100%, 60%, 0.55); }
.btn-primary:hover { box-shadow: 0 14px 40px -8px hsla(248, 100%, 70%, 0.55); transform: translateY(-1px); }
.btn-ghost { background: var(--glass-2); color: var(--t1); border: 1px solid var(--line-2); }
.btn-ghost:hover { border-color: var(--mint); color: var(--mint); }
.btn-sm { padding: 8px 14px; font-size: 13px; }

/* ---------- scan result ---------- */
.scan-result { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: -4px 0 18px; animation: rise 0.4s ease; }
.scan-result > div { background: rgba(93, 255, 196, 0.05); border: 1px solid rgba(93, 255, 196, 0.18); border-radius: 12px; padding: 10px 12px; }
.scan-result .k { display: block; font-size: 11px; color: var(--t3); text-transform: uppercase; letter-spacing: 0.06em; }
.scan-result .v { font-family: var(--display); font-size: 17px; font-weight: 600; }
@keyframes rise { from { opacity: 0; transform: translateY(8px); } }

/* ---------- roles ---------- */
.roles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.role { position: relative; cursor: pointer; border: 1px solid var(--line); border-radius: 14px; padding: 14px 10px; text-align: center; background: var(--glass-2); transition: all 0.2s; display: flex; flex-direction: column; gap: 2px; }
.role input { position: absolute; opacity: 0; pointer-events: none; }
.role:hover { border-color: var(--line-2); transform: translateY(-2px); }
.r-name { font-family: var(--display); font-weight: 600; font-size: 15px; }
.r-mult { font-family: var(--mono); font-size: 12px; color: var(--t3); }
.role:has(input:checked) { border-color: var(--mint); background: hsla(158, 100%, 68%, 0.08); box-shadow: 0 0 0 3px hsla(158, 100%, 68%, 0.1); }
.role:has(input:checked) .r-mult { color: var(--mint); }
.role-top:has(input:checked) { border-color: var(--violet); background: hsla(248, 100%, 74%, 0.1); box-shadow: 0 0 24px -4px hsla(248, 100%, 74%, 0.45); }
.role-top:has(input:checked) .r-mult { color: var(--violet); }
.role:has(input:focus-visible) { outline: 2px solid var(--mint); outline-offset: 2px; }

/* ---------- epochs ---------- */
.epochs { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; }
.epoch { display: grid; grid-template-columns: 90px 1fr 1fr 34px; gap: 10px; align-items: end; padding: 12px; border: 1px solid var(--line); border-radius: 14px; background: rgba(0, 0, 0, 0.2); animation: rise 0.3s ease; }
.epoch .e-name { font-family: var(--display); font-weight: 600; align-self: center; }
.epoch .field { margin: 0; }
.epoch .lbl { font-size: 11.5px; }
.epoch .rm { background: none; border: 1px solid var(--line); color: var(--t3); border-radius: 10px; height: 44px; cursor: pointer; transition: all 0.2s; }
.epoch .rm:hover { color: var(--danger); border-color: var(--danger); }

/* ---------- advanced ---------- */
.advanced { margin-top: 20px; border: 1px dashed var(--line-2); border-radius: 14px; padding: 4px 16px; }
.advanced summary { cursor: pointer; padding: 12px 0; font-size: 13px; color: var(--t2); font-weight: 500; }
.advanced[open] summary { color: var(--mint); }
.adv-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 12px; }
.adv-grid .lbl { font-size: 11.5px; }

/* ---------- results ---------- */
.results { position: sticky; top: 84px; min-height: 420px; }
.empty { text-align: center; padding: 60px 20px; color: var(--t3); }
.empty-mark { font-size: 64px; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; animation: spin 14s linear infinite; display: inline-block; }
.identity { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
.tag { font-family: var(--mono); font-size: 12px; padding: 5px 10px; border-radius: 8px; background: var(--glass-2); border: 1px solid var(--line); color: var(--t2); }
.tag.role-tag { color: var(--mint); border-color: hsla(158, 100%, 68%, 0.35); }
.tag.role-tag.z { color: var(--violet); border-color: hsla(248, 100%, 74%, 0.45); }
.big { display: flex; flex-direction: column; gap: 6px; padding: 22px; border-radius: 16px; background: linear-gradient(140deg, hsla(158, 100%, 68%, 0.1), hsla(248, 100%, 74%, 0.12)); border: 1px solid var(--line-2); position: relative; overflow: hidden; }
.big::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.06) 50%, transparent 70%); transform: translateX(-100%); animation: shine 4s ease-in-out infinite; }
@keyframes shine { 60%, 100% { transform: translateX(100%); } }
.big .k { font-size: 12px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--t2); }
.big .v { font-family: var(--display); font-size: clamp(38px, 5vw, 54px); font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; }
.big .v small { font-size: 18px; color: var(--t2); font-weight: 500; }
.big .range { font-size: 13px; color: var(--t2); }
.big .range b { color: var(--t1); font-weight: 600; }

.breakdown { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin: 18px 0; border-radius: 14px; overflow: hidden; background: var(--line); border: 1px solid var(--line); }
.b-row { display: flex; justify-content: space-between; gap: 8px; padding: 11px 14px; background: var(--bg-2); font-size: 13px; color: var(--t2); }
.b-row span:last-child { font-family: var(--mono); color: var(--t1); }

/* ---------- vesting ---------- */
.v-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.v-head h3 { font-family: var(--display); margin: 0; font-size: 16px; }
.v-head select { width: auto; max-width: 62%; padding: 8px 10px; font-size: 12.5px; }
.chart { height: 210px; }
.chart svg { width: 100%; height: 100%; overflow: visible; }
.chart .bar { transition: height 0.6s cubic-bezier(.2,.8,.2,1), y 0.6s cubic-bezier(.2,.8,.2,1); }
.chart .bar:hover { filter: brightness(1.3); }
.chart text { fill: var(--t3); font: 10px var(--mono); }
.chart .val { fill: var(--t2); }
.v-legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12px; color: var(--t2); margin-top: 8px; align-items: center; }
.sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
.sw-tge { background: var(--violet); }
.sw-lin { background: var(--mint); }
.muted { color: var(--t3); margin-left: auto; font-family: var(--mono); }

/* ---------- disclaimer / footer ---------- */
.disclaimer { margin: 28px 0 10px; padding: 22px 26px; border-color: hsla(38, 100%, 64%, 0.25); }
.disclaimer h3 { margin: 0 0 6px; font-family: var(--display); color: var(--amber); font-size: 15px; }
.disclaimer p { margin: 0; color: var(--t2); font-size: 13.5px; }
.foot { text-align: center; color: var(--t3); font-size: 12px; padding: 26px 0 40px; font-family: var(--mono); }

.spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: spin 0.7s linear infinite; vertical-align: -2px; }

/* ---------- responsive ---------- */
@media (max-width: 960px) {
  .grid-main { grid-template-columns: 1fr; }
  .results { position: static; }
}
@media (max-width: 640px) {
  .hero-stats, .row-2, .adv-grid { grid-template-columns: 1fr; }
  .roles { grid-template-columns: repeat(2, 1fr); }
  .scan-result { grid-template-columns: repeat(2, 1fr); }
  .epoch { grid-template-columns: 1fr 1fr; }
  .epoch .e-name { grid-column: 1 / -1; }
  .breakdown { grid-template-columns: 1fr; }
  .input-row { flex-direction: column; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}
